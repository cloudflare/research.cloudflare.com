---
import HeaderAlumni from "@/components/HeaderAlumni.astro";
import InteriorLayout from "../../layouts/interior.astro";
import Section from "@/components/Section.astro";
import AlumniCard from "@/components/AlumniCard.astro";
import { cn } from "@/lib/utils";

const { t, getLocalizedCollection } = Astro.locals;

const alumni = await getLocalizedCollection("people", ({ data }) => data.type === "alumni");
---

<InteriorLayout metaTitle={t("people.alumni")} metaDescription="Meet the alumni of Cloudflare Research, whose work has helped advance internet security, privacy, and performance.">
  <HeaderAlumni />

  <Section>
    <div class={cn("grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 person-grid",
      "[&>article]:p-8")}>
      {alumni.map(person =>(
        <AlumniCard image={person.data.avatar} name={person.data.title} role={person.data.position} slug={person.data.slug} />
      ))}
    </div>
  </Section>
</InteriorLayout>
